# Fichier d'exemple — copier en .env et remplir les valeurs
# NE JAMAIS commiter .env (voir .gitignore)

# Base de donnees PostgreSQL
POSTGRES_USER=habitat_user
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=habitat_ift785
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Configuration application
APP_ENV=production
APP_SECRET_KEY=changeme_random_secret_key
DEBUG=false

# Port expose par nginx
NGINX_PORT=80

# Circuit Breaker
CB_FAILURE_THRESHOLD=3
CB_RECOVERY_TIMEOUT=60

# JWT / Auth (si active)
JWT_SECRET=changeme_jwt_secret
